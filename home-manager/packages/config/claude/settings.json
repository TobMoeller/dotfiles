{
  "permissions": {
    "allow": [
      "Read(~/.claude/**)",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Read(~/code/brain/**)",
      "Edit(~/code/brain/**)",
      "Write(~/code/brain/**)",
      "Bash(phpunit:*)",
      "Bash(vendor/bin/phpunit:*)",
      "Bash(./vendor/bin/phpunit:*)",
      "Bash(php artisan test:*)",
      "Bash(pint:*)",
      "Bash(vendor/bin/pint:*)",
      "Bash(./vendor/bin/pint:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(sudo:*)",
      "Bash(find * -exec *)",
      "Bash(find * -execdir *)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(find * -delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/bash-guard.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "php-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "theme": "dark"
}
