#!/usr/bin/env bash

# wt - git worktrees as tmux/herdr sessions, for running multiple agents in parallel
#
# Inside herdr (HERDR_ENV set) each worktree becomes a herdr *space* (workspace);
# otherwise a tmux session. All the env/port/docker/dep bootstrapping is identical
# — only the session layer differs.
#
#   wt              fzf over existing worktrees, switch/attach (creates the
#                   session again if it is gone, e.g. after a reboot)
#   wt add          pick a repo from ~/code, then pick an existing branch or
#                   type a new name; creates worktree + tmux session
#   wt rm           pick a worktree, tear it down (tmux session, docker
#                   compose stack incl. volumes, git worktree)
#   wt ls           list existing worktrees
#
# Worktrees live under $WT_ROOT/<repo>/<branch>, separate from ~/code.
#
# Per-repo conventions (all optional, checked in the main checkout):
#   .env             copied into the worktree, then COMPOSE_PROJECT_NAME is
#                    set and host ports (APP_PORT, VITE_PORT, FORWARD_*_PORT)
#                    are shifted by a per-worktree offset
#   .worktree-files  additional git-ignored paths to copy, one per line
#   .worktree-setup.sh  executed inside the first tmux window after creation
#                    (composer install, sail up, artisan migrate, ...)
#   tools/setup-worktree.sh  if present & executable, owns env setup (env files,
#                    host ports, compose project name); wt runs it in the
#                    foreground instead of its own .env copy + port shift, so
#                    .env/.env.testing exist as soon as `wt add` returns
#
# vendor/ and node_modules/ are copied with --reflink when the filesystem
# supports it, so a 'composer install'/'npm install' in the setup script only
# has to fix up the diff to the branch.

set -euo pipefail

CODE_DIR="${WT_CODE_DIR:-$HOME/code}"
WT_ROOT="${WT_ROOT:-$CODE_DIR/worktrees}"
PORT_OFFSET_STEP=10

die() { echo "wt: $*" >&2; exit 1; }

# repo/branch -> session/space name (no '.' or ':' allowed; used as tmux session
# name or herdr workspace label)
session_name() {
    echo "$1--$2" | tr './:' '___'
}

# herdr workspace_id for a given label, empty if none exists
herdr_ws_id() {
    herdr workspace list \
        | jq -r --arg l "$1" 'first(.result.workspaces[] | select(.label==$l) | .workspace_id) // empty'
}

# list existing worktrees as "repo/branch" lines
list_worktrees() {
    [[ -d "$WT_ROOT" ]] || return 0
    find "$WT_ROOT" -mindepth 2 -maxdepth 2 -type d | sed "s|^$WT_ROOT/||" | sort
}

attach_session() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$1"
    else
        tmux new-session -A -s "$1"
    fi
}

# ensure a session exists for worktree path $2 with name $1, then attach.
# A single window at the worktree root - windows are yours to arrange.
ensure_session() {
    local session=$1 path=$2 setup=${3:-}

    if [[ -n "${HERDR_ENV:-}" ]]; then
        local id
        id=$(herdr_ws_id "$session")
        if [[ -n "$id" ]]; then
            herdr workspace focus "$id"
        else
            local root
            root=$(herdr workspace create --cwd "$path" --label "$session" --focus \
                | jq -r '.result.root_pane.pane_id // empty')
            # run the setup command in the new space's root pane (text + Enter)
            [[ -n "$setup" && -n "$root" ]] && herdr pane run "$root" "$setup"
        fi
        return
    fi

    if ! tmux has-session -t "=$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -c "$path"
        if [[ -n "$setup" ]]; then
            tmux send-keys -t "=$session" "$setup" C-m
        fi
    fi

    attach_session "$session"
}

cmd_ls() {
    list_worktrees
}

cmd_switch() {
    local selected repo branch
    selected=$(list_worktrees | fzf --prompt='worktree> ') || exit 0
    [[ -n "$selected" ]] || exit 0
    repo=${selected%%/*}
    branch=${selected#*/}
    ensure_session "$(session_name "$repo" "$branch")" "$WT_ROOT/$selected"
}

# copy a git-ignored file/dir from the main checkout into the worktree
copy_item() {
    local repo=$1 path=$2 item=$3
    [[ -e "$repo/$item" ]] || return 0
    mkdir -p "$(dirname "$path/$item")"
    cp -a "$repo/$item" "$path/$item"
}

# copy dependency dirs with copy-on-write when available
copy_deps() {
    local src=$1 dst=$2
    cp -a --reflink=auto "$src" "$dst" 2>/dev/null && return 0
    rm -rf "$dst"
    cp -ca "$src" "$dst" 2>/dev/null && return 0 # macOS clonefile
    rm -rf "$dst"
    cp -a "$src" "$dst"
}

# make the copied .env safe to run next to the other stacks
patch_env() {
    local env_file=$1 project=$2 offset=$3

    if grep -q '^COMPOSE_PROJECT_NAME=' "$env_file"; then
        sed "s/^COMPOSE_PROJECT_NAME=.*/COMPOSE_PROJECT_NAME=$project/" "$env_file" > "$env_file.tmp"
    else
        cat "$env_file" > "$env_file.tmp"
        printf '\nCOMPOSE_PROJECT_NAME=%s\n' "$project" >> "$env_file.tmp"
    fi

    awk -v off="$offset" 'BEGIN { FS = OFS = "=" }
        /^(APP_PORT|VITE_PORT|FORWARD_[A-Z_]+_PORT)=[0-9]+[[:space:]]*$/ { $2 = $2 + off }
        { print }' "$env_file.tmp" > "$env_file"
    rm -f "$env_file.tmp"
}

# pick the base for a new branch: remote branches, default branch preselected
pick_base_branch() {
    local repo=$1 branch=$2 default
    default=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD || true)
    default=${default:-origin/develop}

    {
        echo "$default"
        git -C "$repo" branch --remotes --format='%(refname:short)' \
            | grep -vx -e 'origin' -e 'origin/HEAD' -e "$default" | sort
    } | fzf --prompt='base> ' --header="base for new branch $branch"
}

# Slow worktree bootstrap: copy vendor/node_modules, then run a generic
# .worktree-setup.sh build step (composer/npm install) which needs those deps
# present. Invoked inside the worktree's own session (see cmd_add) so it never
# blocks `wt add` or your current window. Env setup already ran in cmd_add.
cmd_bootstrap() {
    local repo=$1 path=$2

    local dep
    for dep in vendor node_modules; do
        if [[ -d "$repo/$dep" && ! -e "$path/$dep" ]]; then
            echo "wt: copying $dep ..."
            copy_deps "$repo/$dep" "$path/$dep"
        fi
    done

    [[ -x "$path/.worktree-setup.sh" ]] && ( cd "$path" && exec ./.worktree-setup.sh )
}

cmd_add() {
    local repo=${1:-} branch=${2:-}

    if [[ -z "$repo" ]]; then
        repo=$(find "$CODE_DIR" -mindepth 2 -maxdepth 3 -name .git -prune \
            -not -path "$WT_ROOT/*" \
            | sed 's|/\.git$||' | sort | fzf --prompt='repo> ') || exit 0
    fi
    [[ -d "$repo/.git" || -f "$repo/.git" ]] || die "not a git repository: $repo"
    local repo_name
    repo_name=$(basename "$repo")

    if [[ -z "$branch" ]]; then
        # pick an existing branch or type a new name (fzf --print-query)
        local out="" status=0
        out=$(git -C "$repo" branch --all --format='%(refname:short)' \
            | sed 's|^origin/||' | grep -vx 'HEAD' | sort -u \
            | fzf --print-query --prompt='branch> ') || status=$?
        [[ $status -gt 1 ]] && exit 0 # aborted (ESC), fzf still prints the query
        branch=$(tail -1 <<< "$out")
    fi
    [[ -n "$branch" ]] || exit 0

    local branch_dir session path
    branch_dir=$(echo "$branch" | tr '/.' '--')
    session=$(session_name "$repo_name" "$branch_dir")
    path="$WT_ROOT/$repo_name/$branch_dir"

    # already there? just go to it
    if [[ -d "$path" ]]; then
        ensure_session "$session" "$path"
        exit 0
    fi

    echo "wt: fetching origin ..."
    git -C "$repo" fetch --prune origin || echo "wt: fetch failed, using local refs" >&2

    mkdir -p "$WT_ROOT/$repo_name"
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
        git -C "$repo" worktree add "$path" "$branch"
    elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$repo" worktree add --track -b "$branch" "$path" "origin/$branch"
    else
        local base
        base=$(pick_base_branch "$repo" "$branch") || exit 0
        [[ -n "$base" ]] || exit 0
        git -C "$repo" worktree add --no-track -b "$branch" "$path" "$base"
    fi

    # --- Env setup: fast, and done in the foreground so .env/.env.testing exist
    #     the moment `wt add` returns (docker compose interpolates them). A repo
    #     can own this via tools/setup-worktree.sh (env files + host ports +
    #     compose project name); otherwise wt copies + patches .env itself. -----
    if [[ -x "$path/tools/setup-worktree.sh" ]]; then
        echo "wt: running tools/setup-worktree.sh ..."
        ( cd "$path" && ./tools/setup-worktree.sh ) \
            || echo "wt: tools/setup-worktree.sh failed -- opening the session anyway" >&2
    else
        copy_item "$repo" "$path" .env
        if [[ -f "$path/.env" ]]; then
            local index offset project
            index=$(find "$WT_ROOT/$repo_name" -mindepth 1 -maxdepth 1 -type d | wc -l)
            offset=$((index * PORT_OFFSET_STEP))
            project=$(printf '%s' "$repo_name-$branch_dir" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')
            patch_env "$path/.env" "$project" "$offset"
            echo "wt: patched .env (COMPOSE_PROJECT_NAME=$project, port offset +$offset)"
        fi
    fi

    if [[ -f "$repo/.worktree-files" ]]; then
        while IFS= read -r item; do
            [[ -n "$item" && "${item:0:1}" != "#" ]] && copy_item "$repo" "$path" "$item"
        done < "$repo/.worktree-files"
    fi

    # --- Slow work (reflink dep copy + any .worktree-setup.sh build step) runs
    #     *inside* the new session, so `wt add` returns at once -- jump back to
    #     your previous window and let it finish in the background. ------------
    local setup=""
    if [[ -x "$path/.worktree-setup.sh" || -d "$repo/vendor" || -d "$repo/node_modules" ]]; then
        setup="wt _bootstrap $(printf '%q' "$repo") $(printf '%q' "$path")"
    fi
    ensure_session "$session" "$path" "$setup"
}

cmd_rm() {
    local selected=${1:-}
    if [[ -z "$selected" ]]; then
        selected=$(list_worktrees | fzf --prompt='remove worktree> ') || exit 0
    fi
    [[ -n "$selected" ]] || exit 0

    local repo_name=${selected%%/*} branch_dir=${selected#*/}
    local path="$WT_ROOT/$repo_name/$branch_dir"
    [[ -d "$path" ]] || die "no such worktree: $path"

    if [[ -n "${HERDR_ENV:-}" ]]; then
        local ws_id
        ws_id=$(herdr_ws_id "$(session_name "$repo_name" "$branch_dir")" || true)
        [[ -n "$ws_id" ]] && herdr workspace close "$ws_id" 2>/dev/null || true
    else
        tmux kill-session -t "=$(session_name "$repo_name" "$branch_dir")" 2>/dev/null || true
    fi

    if [[ -f "$path/docker-compose.yml" || -f "$path/compose.yaml" || -f "$path/docker-compose.yaml" ]]; then
        echo "wt: tearing down docker compose stack ..."
        (cd "$path" && docker compose down --volumes --remove-orphans) || true
    fi

    local main_repo
    main_repo=$(dirname "$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)")
    if ! git -C "$main_repo" worktree remove "$path" 2>/dev/null; then
        # untracked files (.env, vendor, ...) always make the worktree "dirty",
        # so confirm before forcing in case there are real uncommitted changes
        git -C "$path" status --short
        read -rp "wt: worktree is not clean, remove anyway? [y/N] " answer
        [[ "$answer" == "y" || "$answer" == "Y" ]] || exit 1
        git -C "$main_repo" worktree remove --force "$path"
    fi
    rmdir "$WT_ROOT/$repo_name" 2>/dev/null || true
    echo "wt: removed $selected (its branch was kept)"
}

case "${1:-}" in
    add) shift; cmd_add "$@" ;;
    _bootstrap) shift; cmd_bootstrap "$@" ;;
    rm) shift; cmd_rm "$@" ;;
    ls) cmd_ls ;;
    "") cmd_switch ;;
    -h|--help) sed -n '3,29p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command: $1 (use add, rm, ls or no argument)" ;;
esac
