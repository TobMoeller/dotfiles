#!/usr/bin/env bash

# Credit to ThePrimeagen

if [[ $# -eq 1 ]]; then
    selected=$1
else
    items+=`find ~/code -maxdepth 2 -mindepth 1 -type d ! -wholename '*/RED-telematik-manager*' ! -path '*/code/worktrees*' ! -path '*/code/reviews/*'`
    items+=`echo -e "\n$(find ~/code/RED-telematik-manager -maxdepth 2 -mindepth 1 -type d)"`
    # items+=`echo -e "\n$(find ~/portal -maxdepth 2 -mindepth 1 -type d)"`
    items+=`echo -e "\n/tmp"`
    selected=`echo "$items" | fzf`
    # echo "$items"
fi

[[ -z "$selected" ]] && exit 0   # fzf aborted (Esc/Ctrl-C)

dirname=`basename $selected | sed 's/\./_/g'`

# herdr: a "space" is a workspace. Focus the one whose label matches, else
# create it at the selected dir. Mirrors the tmux switch-or-create below.
if [[ -n "$HERDR_ENV" ]]; then
    existing=`herdr workspace list | jq -r --arg l "$dirname" \
        '.result.workspaces[] | select(.label==$l) | .workspace_id' | head -n1`
    if [[ -n "$existing" ]]; then
        herdr workspace focus "$existing"
    else
        herdr workspace create --cwd "$selected" --label "$dirname" --focus
    fi
    exit $?
fi

# tmux
tmux switch-client -t =$dirname
if [[ $? -eq 0 ]]; then
    exit 0
fi

tmux new-session -c $selected -d -s $dirname && tmux switch-client -t $dirname || tmux new -c $selected -A -s $dirname
