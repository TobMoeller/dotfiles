// Super is Mod in a normal session. Changes are hot-reloaded by niri.
// Hosts may provide native monitor settings next to this symlink.
include optional=true "outputs.kdl"

input {
    keyboard {
        xkb { layout "de"; }
        repeat-delay 300
        repeat-rate 30
    }
    touchpad {
        tap
        // Traditional scrolling; omit natural-scroll to reverse the old setup.
        dwt
    }
}

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    border { off; }
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }

// Keep maximizing/resizing immediate; other animations remain enabled.
animations {
    window-resize { off; }
}

// Noctalia runs only inside this compositor session, not in Plasma.
spawn-at-startup "noctalia"

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}
window-rule {
    match app-id="^firefox$"
    // Start tiled even if Firefox restores a maximized/fullscreen window.
    open-fullscreen false
    open-maximized-to-edges false
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+Space hotkey-overlay-title="Noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+D hotkey-overlay-title="Fallback launcher" { spawn "fuzzel"; }
    Mod+Comma hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+S hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+E hotkey-overlay-title="Session menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Ctrl+Shift+E hotkey-overlay-title="Exit niri" { quit; }
    Mod+Q { close-window; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Alt+Left hotkey-overlay-title="Focus left monitor" { focus-monitor-left; }
    Mod+Alt+Right hotkey-overlay-title="Focus right monitor" { focus-monitor-right; }
    Mod+Shift+Left hotkey-overlay-title="Move window to left monitor" { move-window-to-monitor-left; }
    Mod+Shift+Right hotkey-overlay-title="Move window to right monitor" { move-window-to-monitor-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Tab { toggle-overview; }
    Mod+F hotkey-overlay-title="Maximize, keep bar visible" { maximize-window-to-edges; }
    Mod+Shift+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+M { maximize-column; }
    Mod+C { center-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+Space { toggle-window-floating; }
    Print { screenshot; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
}
