# Keep this file quiet: it also runs for non-interactive zsh commands.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Home Manager generates package-dependent environment integration only.
if [[ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]]; then
  if [[ -n ${IN_NIX_SHELL:-} ]]; then
    _dotfiles_dev_path=$PATH
  fi
  source "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
  if (( ${+_dotfiles_dev_path} )); then
    export PATH=$_dotfiles_dev_path
    unset _dotfiles_dev_path
  fi
fi

# Refresh the checkout path even in shells inheriting HM's once-only marker.
if [[ -r "$XDG_CONFIG_HOME/dotfiles/session.zsh" ]]; then
  source "$XDG_CONFIG_HOME/dotfiles/session.zsh"
fi
