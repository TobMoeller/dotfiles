#!/usr/bin/env bash
# Connect to or disconnect from the home network via Tailscale.
# See docs/tailscale.md.
set -euo pipefail

home_prefix="192.168.178."
home_probe="192.168.178.1"

local_overlap() {
  ip -4 -o addr show | grep -v ' tailscale0 ' | grep -q " inet ${home_prefix//./\\.}"
}

case "${1:-status}" in
  on)
    if local_overlap; then
      echo "Lokales Netz nutzt selbst ${home_prefix}x: verbinde ohne Heimnetzroute." >&2
      sudo tailscale up --accept-routes=false --accept-dns=false
    else
      sudo tailscale up --accept-routes --accept-dns=false
    fi
    ;;
  off)
    sudo tailscale down
    # tailscaled keeps its ip rules while running; they point to table 52,
    # which down empties, so routing falls through to the main table.
    if [[ -n "$(ip route show table 52)" ]]; then
      echo "Achtung: Tailscale-Routen sind noch vorhanden (ip route show table 52)." >&2
      exit 1
    fi
    echo "Getrennt, Routing wieder normal."
    ;;
  status)
    tailscale status || true
    if ip route get "$home_probe" 2>/dev/null | grep -q 'dev tailscale0'; then
      echo "Heimnetz: über Tailscale"
    else
      echo "Heimnetz: nicht über Tailscale"
    fi
    ;;
  *)
    echo "usage: homenet [on|off|status]" >&2
    exit 2
    ;;
esac
